-- ══════════════════════════════════════════════
-- SLASH COMMAND PARSER
-- ══════════════════════════════════════════════
local function handleSlashCommand(raw)
    local cmd, arg = raw:match("^/(%w+)%s*(.*)")
    if not cmd then return false end
    cmd = cmd:lower()

    if cmd == "dex" then
        local target = (arg and arg ~= "") and arg or "game"
        local snap = snapshotDex(target)
        addMessage("system", "📸 Dex snapshot: "..target)
        sendToAI(snap, nil, true)
        return true

    elseif cmd == "spy" then
        if not spyActive then startSpy() else stopSpy() end
        return true

    elseif cmd == "analyze" or cmd == "analyse" then
        if #remoteLogs == 0 then
            addMessage("system","⚠ No remote logs yet — enable spy first")
        else
            local block = formatRemoteLogs(remoteLogs, 30)
            addMessage("system","🔍 Sending "..#remoteLogs.." remote logs to AI...")
            sendToAI(block, nil, true)
        end
        return true

    elseif cmd == "clear" then
        history={}; remoteLogs={}; msgCount=0
        for _,c in ipairs(ChatScroll:GetChildren()) do
            if c:IsA("Frame") then c:Destroy() end
        end
        addMessage("system","🗑 Chat and remote logs cleared")
        return true

    elseif cmd == "help" then
        addMessage("system",
            "BloxChat Commands:\n"..
            "/dex [path]    — snapshot instance tree\n"..
            "/spy           — toggle remote spy\n"..
            "/analyze       — send captured remotes to AI\n"..
            "/clear         — clear chat + logs\n"..
            "/help          — this message\n\n"..
            "Or just chat normally — AI knows Dex/sUNC/Delta"
        )
        return true
    end
    return false
end

