-- MESSAGE RENDERER
-- ══════════════════════════════════════════════
local msgCount = 0
local typing   = false

local function scrollBottom()
    task.wait()
    ChatScroll.CanvasPosition = Vector2.new(0, ChatScroll.AbsoluteCanvasSize.Y + 9999)
end

local function addMessage(role, text)
    msgCount = msgCount + 1
    local isUser = role == "user"
    local isSys  = role == "system"

    local Row = Instance.new("Frame")
    Row.LayoutOrder = msgCount; Row.Size=UDim2.new(1,0,0,0)
    Row.AutomaticSize=Enum.AutomaticSize.Y; Row.BackgroundTransparency=1
    Row.Parent=ChatScroll

    local bubW = isSys and 1.0 or 0.82
    local bubX = (isUser and not isSys) and (1-bubW) or 0

    local Bubble = Instance.new("Frame")
    Bubble.Size=UDim2.new(bubW,0,0,0); Bubble.Position=UDim2.new(bubX,0,0,0)
    Bubble.AutomaticSize=Enum.AutomaticSize.Y
    Bubble.BackgroundColor3 = isSys and C.MSG_SYS or (isUser and C.MSG_USER or C.MSG_AI)
    Bubble.BorderSizePixel=0; Bubble.Parent=Row
    Instance.new("UICorner",Bubble).CornerRadius=UDim.new(0,8)
    local bp=Instance.new("UIPadding",Bubble)
    bp.PaddingTop=UDim.new(0,6); bp.PaddingBottom=UDim.new(0,6)
    bp.PaddingLeft=UDim.new(0,10); bp.PaddingRight=UDim.new(0,10)

    local Sender = Instance.new("TextLabel")
    Sender.Size=UDim2.new(1,0,0,13); Sender.BackgroundTransparency=1
    Sender.Font=Enum.Font.GothamBold; Sender.TextSize=9
    Sender.TextXAlignment=Enum.TextXAlignment.Left; Sender.Parent=Bubble
    if isSys then
        Sender.Text="🔧 SYSTEM"; Sender.TextColor3=C.ORANGE
    elseif isUser then
        Sender.Text=LocalPlayer.Name; Sender.TextColor3=Color3.fromRGB(255,255,255)
    else
        Sender.Text="BloxChat AI"; Sender.TextColor3=C.GREEN
    end

    local Msg = Instance.new("TextLabel")
    Msg.Size=UDim2.new(1,0,0,0); Msg.Position=UDim2.new(0,0,0,14)
    Msg.AutomaticSize=Enum.AutomaticSize.Y; Msg.BackgroundTransparency=1
    Msg.Font=Enum.Font.Gotham; Msg.Text=text; Msg.TextColor3=C.TEXT
    Msg.TextSize=12; Msg.TextWrapped=true
    Msg.TextXAlignment=Enum.TextXAlignment.Left; Msg.Parent=Bubble

    scrollBottom()
    return Msg
end

local function addTypingIndicator()
    msgCount=msgCount+1
    local Row=Instance.new("Frame"); Row.LayoutOrder=msgCount
    Row.Size=UDim2.new(1,0,0,34); Row.BackgroundTransparency=1; Row.Parent=ChatScroll
    local Bub=Instance.new("Frame"); Bub.Size=UDim2.new(0.45,0,1,0)
    Bub.BackgroundColor3=C.MSG_AI; Bub.BorderSizePixel=0; Bub.Parent=Row
    Instance.new("UICorner",Bub).CornerRadius=UDim.new(0,8)
    local Lbl=Instance.new("TextLabel",Bub); Lbl.Size=UDim2.new(1,0,1,0)
    Lbl.BackgroundTransparency=1; Lbl.Font=Enum.Font.GothamBold
    Lbl.TextColor3=C.TEXT_DIM; Lbl.TextSize=12; Lbl.Text="BloxChat is thinking..."
    scrollBottom()
    local dots=0; local running=true
    local conn=RunService.Heartbeat:Connect(function()
        if not running then return end
        dots=(dots+1)%4; Lbl.Text="BloxChat is thinking"..string.rep(".",dots)
    end)
    return function() running=false; conn:Disconnect(); Row:Destroy() end
end

-- ══════════════════════════════════════════════
-- AI SEND WITH HISTORY
-- ══════════════════════════════════════════════
local function sendToAI(userMsg, displayMsg, isAutomatic)
    if typing then return end
    typing=true
    SendBtn.BackgroundColor3=Color3.fromRGB(60,60,60)

    if not isAutomatic then
        addMessage("user", displayMsg or userMsg)
    end
    table.insert(history, {role="user", content=userMsg})

    local stopTyping = addTypingIndicator()

    callAI(userMsg, function(reply, err)
        stopTyping(); typing=false
        SendBtn.BackgroundColor3=C.ACCENT
        local msg = err and ("❌ Error: "..err) or reply
        addMessage("assistant", msg)
        table.insert(history, {role="assistant", content=msg})
        if #history > 40 then
            table.remove(history,1); table.remove(history,1)
        end
    end)
end

-- ══════════════════════════════════════════════
-- REMOTE SPY ENGINE
-- ══════════════════════════════════════════════
local function logRemote(remotePath, method, args, retVal)
    local entry = {
        time      = os.date("%H:%M:%S"),
        path      = remotePath,
        method    = method,
        args      = serializeArgs(args),
        returnVal = retVal and serializeValue(retVal) or "",
    }
    table.insert(remoteLogs, entry)
    if #remoteLogs > CONFIG.maxRemoteLogs then table.remove(remoteLogs,1) end

    SpyStatus.Text = "Remote Spy: ON  |  Captured: "..#remoteLogs

    -- Display in chat as a system message (compact)
    local line = string.format("[SPY] %s::%s%s", remotePath, method, entry.args)
    if entry.returnVal ~= "" then line = line.." → "..entry.returnVal end
    addMessage("system", line)

    -- Auto-analyze every N remotes if configured
    local N = tonumber(AutoTb.Text) or 0
    if N > 0 and #remoteLogs % N == 0 then
        local logBlock = formatRemoteLogs(remoteLogs, N)
        addMessage("system", "⚡ Auto-analyzing last "..N.." remotes...")
        sendToAI(logBlock, nil, true)
    end
end

local function startSpy()
    if spyActive then return end
    spyActive = true

    local gm = getrawmetatable and getrawmetatable(game)
    if not gm then
        addMessage("system","❌ getrawmetatable not available — spy requires sUNC/Delta")
        spyActive=false; return
    end

    local oldNC = gm.__namecall
    originalNC  = oldNC

    local newNC = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if method == "FireServer" or method == "fireServer" or
           method == "InvokeServer" or method == "invokeServer" then
            local ok, name = pcall(function() return self.Name end)
            if ok then
                local args = {...}
                local path = pcall(getInstancePath, self) and getInstancePath(self) or self.Name
                if method:lower():find("invoke") then
                    local ret = {oldNC(self,...)}
                    logRemote(path, method, args, ret[1])
                    return unpack(ret)
                else
                    logRemote(path, method, args, nil)
                end
            end
        end
        return oldNC(self,...)
    end, oldNC)

    if setreadonly then setreadonly(gm, false) end
    gm.__namecall = newNC
    if setreadonly then setreadonly(gm, true) end

    SpyBtn.Text = "🟢 Spy ON"
    SpyBtn.BackgroundColor3 = Color3.fromRGB(50,80,50)
    SpyStatus.Text = "Remote Spy: ON  |  Captured: "..#remoteLogs
    addMessage("system", "✅ Remote Spy started — watching FireServer / InvokeServer calls")

    _G.BloxChatRemoteSpy = {
        stop = function()
            if not spyActive then return end
            spyActive = false
            if setreadonly then setreadonly(gm,false) end
            gm.__namecall = oldNC
            if setreadonly then setreadonly(gm,true) end
            SpyBtn.Text="🔴 Spy OFF"; SpyBtn.BackgroundColor3=C.INPUT_BG
            SpyStatus.Text="Remote Spy: OFF  |  Captured: "..#remoteLogs
        end
    }
end

local function stopSpy()
    if _G.BloxChatRemoteSpy then
        pcall(_G.BloxChatRemoteSpy.stop)
    end
end

