-- ══════════════════════════════════════════════
-- DEX TREE HELPER
-- ══════════════════════════════════════════════
local function getInstancePath(obj)
    local path = ""
    local cur  = obj
    local steps = 0
    while cur and cur ~= game and steps < 10 do
        local name = cur.Name:gsub("[^%w_]","_")
        path = "."..name..path
        cur  = cur.Parent
        steps = steps + 1
    end
    return "game"..path
end

local function serializeValue(v)
    local t = typeof(v)
    if t == "Instance"  then return "<"..v.ClassName..": "..v.Name..">" end
    if t == "string"    then return '"'..tostring(v):sub(1,60)..'"' end
    if t == "number"    then return tostring(v) end
    if t == "boolean"   then return tostring(v) end
    if t == "Vector3"   then return string.format("Vector3(%.2f,%.2f,%.2f)",v.X,v.Y,v.Z) end
    if t == "CFrame"    then return string.format("CFrame(%.2f,%.2f,%.2f)",v.Position.X,v.Position.Y,v.Position.Z) end
    if t == "table"     then return "{table}" end
    return "<"..t..">" 
end

local function serializeArgs(args)
    local parts = {}
    for i,v in ipairs(args) do
        parts[i] = serializeValue(v)
    end
    return "("..table.concat(parts,", ")..")"
end

local function buildDexTree(root, depth, maxDepth, maxChildren)
    if depth > maxDepth then return "" end
    local indent = string.rep("  ", depth)
    local result = indent.."["..root.ClassName.."] "..root.Name.."\n"
    local children = root:GetChildren()
    local count = math.min(#children, maxChildren)
    for i = 1, count do
        result = result .. buildDexTree(children[i], depth+1, maxDepth, maxChildren)
    end
    if #children > maxChildren then
        result = result..indent.."  ... and "..(#children-maxChildren).." more\n"
    end
    return result
end

local function snapshotDex(target)
    -- target: Instance or service name string or nil (= game)
    local root = game
    if type(target) == "string" then
        local ok, svc = pcall(function() return game:GetService(target) end)
        if ok and svc then root = svc
        else
            local found = game:FindFirstChild(target, true)
            if found then root = found end
        end
    elseif typeof(target) == "Instance" then
        root = target
    end

    local tree = buildDexTree(root, 0, CONFIG.maxDexDepth, CONFIG.maxDexChildren)
    return string.format("[DEX SNAPSHOT] Path: %s\n```\n%s```", getInstancePath(root), tree)
end

local function formatRemoteLogs(logs, limit)
    local lines = {"[REMOTE SPY LOG] Last "..#logs.." remote calls:"}
    local start = math.max(1, #logs - (limit or 20) + 1)
    for i = start, #logs do
        local l = logs[i]
        lines[#lines+1] = string.format(
            "[%s] %s::%s%s → %s",
            l.time, l.path, l.method, l.args,
            l.returnVal ~= "" and ("return "..l.returnVal) or "void"
        )
    end
    return table.concat(lines, "\n")
end

-- ══════════════════════════════════════════════
-- HTTP / AI
-- ══════════════════════════════════════════════
local request = (syn and syn.request) or (http and http.request) or
                http_request or (fluxus and fluxus.request) or request

local history = {}

local function callAI(userMsg, callback)
    local p   = getProvider()
    local mdl = getModel()
    local key = CONFIG.apiKey

    local msgs = {{role="system", content=CONFIG.systemPrompt}}
    -- keep last 20 history entries
    local hStart = math.max(1, #history-19)
    for i = hStart, #history do
        table.insert(msgs, {role=history[i].role, content=history[i].content})
    end
    table.insert(msgs, {role="user", content=userMsg})

    local body = HttpService:JSONEncode({
        model      = mdl,
        messages   = msgs,
        max_tokens = 1200,
    })
    local headers = {["Content-Type"]="application/json"}
    if key and key ~= "" then headers["Authorization"] = "Bearer "..key end

    local url = p.baseUrl.."/chat/completions"
    if p.id == "gemini" and key ~= "" then
        url = url.."?key="..key
        headers["Authorization"] = nil
    end

    task.spawn(function()
        local ok, res = pcall(request,{Url=url,Method="POST",Headers=headers,Body=body})
        if not ok then callback(nil,"request() failed: "..tostring(res)) return end
        if res.StatusCode ~= 200 then callback(nil,"HTTP "..res.StatusCode..": "..tostring(res.Body):sub(1,200)) return end
        local ok2, data = pcall(HttpService.JSONDecode, HttpService, res.Body)
        if not ok2 then callback(nil,"JSON decode failed") return end
        local content = data.choices and data.choices[1] and
                        data.choices[1].message and data.choices[1].message.content
        if not content then callback(nil,"No content") return end
        callback(content, nil)
    end)
end

