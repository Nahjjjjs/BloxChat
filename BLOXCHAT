-- ══════════════════════════════════════════════
local function onSend()
    local text = InputBox.Text:match("^%s*(.-)%s*$")
    if text == "" then return end
    InputBox.Text = ""

    if handleSlashCommand(text) then return end
    sendToAI(text, text, false)
end

